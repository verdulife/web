---
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import { SITE } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = SITE.description, ogImage } = Astro.props;

const siteUrl = Astro.site ?? new URL(SITE.url);
const pageTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).href : undefined;

const today = new Intl.DateTimeFormat("es-ES", {
  day: "2-digit",
  month: "long",
  year: "numeric",
}).format(new Date());
const todayIso = new Date().toISOString().slice(0, 10);

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
  </head>

  <body class="min-h-screen bg-paper text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-3 focus:py-2 focus:font-mono focus:text-xs focus:text-paper"
    >
      Saltar al contenido
    </a>

    <header class="border-b border-line">
      <div class="mx-auto w-full max-w-5xl px-6">
        <div
          class="flex items-baseline justify-between gap-4 pt-6 pb-2 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-ink-muted"
        >
          <span>Edición digital — Sitges · Barcelona</span>
          <time datetime={todayIso}>{today}</time>
        </div>

        <div class="pb-4">
          <a href="/" class="inline-block no-underline">
            <span class="font-serif text-4xl font-medium tracking-tight text-ink sm:text-5xl">
              {SITE.name}
            </span>
          </a>
        </div>

        <div class="editorial-rule--double" aria-hidden="true"></div>

        <nav aria-label="Navegación principal" class="py-3">
          <ul
            class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-[0.72rem] uppercase tracking-[0.18em]"
          >
            {
              SITE.nav.map((item) => {
                const itemPath = item.href.replace(/\/+$/, "") || "/";
                const isCurrent = itemPath === currentPath;
                return (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isCurrent ? "page" : undefined}
                      class:list={[
                        "no-underline transition-colors hover:text-accent",
                        isCurrent ? "text-accent" : "text-ink",
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-5xl px-6">
      <slot />
    </main>

    <footer class="mt-16 border-t border-line">
      <div
        class="mx-auto flex w-full max-w-5xl flex-col gap-1 px-6 py-6 font-mono text-[0.7rem] tracking-[0.08em] text-ink-muted sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="flex items-center gap-3">
          <span>Diseño editorial y tipografía</span>
          <span class="h-px w-8 bg-line" aria-hidden="true"></span>
          <span>{SITE.name}, 2026</span>
        </p>
        <p>Astro · Bun · Tailwind CSS</p>
      </div>
    </footer>

    <div class="texture" aria-hidden="true"></div>
  </body>
</html>
