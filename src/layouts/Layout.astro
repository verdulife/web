---
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import { SITE } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  shell?: "chat";
}

const {
  title,
  description = SITE.description,
  ogImage,
  shell,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(SITE.url);
const pageTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).href : undefined;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = window.localStorage.getItem("verdu-theme"); } catch (e) {}
        var theme = stored === "light" || stored === "dark" ? stored : "auto";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
  </head>

  <body
    class:list={[
      "min-h-screen bg-paper text-ink",
      shell === "chat" && "app-shell",
    ]}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-3 focus:py-2 focus:font-mono focus:text-xs focus:text-paper"
    >
      Saltar al contenido
    </a>

    <header
      class:list={[
        "site-header z-30 border-b border-line bg-paper",
        shell === "chat" ? "relative" : "sticky top-0",
      ]}
    >
      <div class="flex h-full items-center justify-between px-5">
        <a href="/" class="no-underline">
          <span class="font-serif text-3xl font-medium tracking-tight text-ink">V.</span>
        </a>

        <button
          id="menu-button"
          type="button"
          aria-label="Menú"
          class="menu-button cursor-pointer border-0 bg-transparent text-ink transition-colors hover:text-accent"
          aria-expanded="false"
          aria-controls="menu-panel"
        >
          <span class="menu-button-icon" aria-hidden="true"></span>
        </button>
      </div>

      <nav id="menu-panel" aria-label="Navegación" class="site-menu" tabindex="-1">
        <div class="site-menu-inner">
          <ul class="site-menu-list">
            {
              SITE.nav.map((item, i) => {
                const itemPath = item.href.replace(/\/+$/, "") || "/";
                const isCurrent = itemPath === currentPath;
                const index = String(i + 1).padStart(2, "0");
                return (
                  <li class="site-menu-item">
                    <a
                      href={item.href}
                      aria-current={isCurrent ? "page" : undefined}
                      class="site-menu-link"
                    >
                      <span class="site-menu-index" aria-hidden="true">{index}</span>
                      <span class="site-menu-label">{item.label}</span>
                      <span class="site-menu-arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                );
              })
            }
          </ul>

          <nav class="site-menu-theme" aria-label="Tema de la interfaz">
            <button type="button" class="theme-button" data-theme-mode="auto" aria-pressed="false">
              <svg class="theme-icon" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.4" />
                <path d="M8 2 a6 6 0 0 1 0 12 z" fill="currentColor" />
              </svg>
              Auto
            </button>
            <button type="button" class="theme-button" data-theme-mode="light" aria-pressed="false">
              <svg class="theme-icon" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.4" />
                <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
                  <line x1="8" y1="1.2" x2="8" y2="2.8" />
                  <line x1="8" y1="13.2" x2="8" y2="14.8" />
                  <line x1="1.2" y1="8" x2="2.8" y2="8" />
                  <line x1="13.2" y1="8" x2="14.8" y2="8" />
                  <line x1="3.2" y1="3.2" x2="4.4" y2="4.4" />
                  <line x1="11.6" y1="11.6" x2="12.8" y2="12.8" />
                  <line x1="3.2" y1="12.8" x2="4.4" y2="11.6" />
                  <line x1="11.6" y1="4.4" x2="12.8" y2="3.2" />
                </g>
              </svg>
              Claro
            </button>
            <button type="button" class="theme-button" data-theme-mode="dark" aria-pressed="false">
              <svg class="theme-icon" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M9.8 1.8 A6 6 0 1 0 14.2 10 A4.9 4.9 0 0 1 9.8 1.8 Z" fill="currentColor" />
              </svg>
              Oscuro
            </button>
          </nav>

          <p class="site-menu-footer">
            Hecho con ♥ por Verdu — {currentYear}
          </p>
        </div>
      </nav>

      <script is:inline>
        (function () {
          var button = document.getElementById("menu-button");
          var panel = document.getElementById("menu-panel");
          if (!button || !panel) return;

          function toggle(open) {
            var willOpen = typeof open === "boolean" ? open : !panel.classList.contains("is-open");
            panel.classList.toggle("is-open", willOpen);
            button.setAttribute("aria-expanded", String(willOpen));
            // Lock background scroll while the curtain is open (the chat
            // shell is already scroll-locked; regular pages need it here).
            document.documentElement.style.overflow = willOpen ? "hidden" : "";
            if (willOpen) panel.focus();
          }

          button.addEventListener("click", function (event) {
            event.stopPropagation();
            toggle();
          });

          panel.addEventListener("click", function (event) {
            if (event.target && event.target.closest && event.target.closest("a")) {
              toggle(false);
            }
          });

          document.addEventListener("click", function (event) {
            if (!panel.classList.contains("is-open")) return;
            if (event.target && event.target.closest && event.target.closest("header")) return;
            toggle(false);
          });

          document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
              toggle(false);
              button.focus();
            }
          });
        })();
      </script>

      <script is:inline>
        (function () {
          // Theme selector (AUTO / CLARO / OSCURO): persist the manual choice
          // in localStorage and apply it on <html>. The pre-paint script in
          // <head> already applied it before first paint; here we only wire
          // clicks and restore the pressed state. The menu stays open: these
          // are buttons, not links, so the close-on-link handler above never
          // fires for them.
          var themeButtons = document.querySelectorAll(".theme-button");
          var storedTheme = null;
          try { storedTheme = window.localStorage.getItem("verdu-theme"); } catch (e) {}
          var currentTheme = storedTheme === "light" || storedTheme === "dark" ? storedTheme : "auto";

          function syncPressed(active) {
            themeButtons.forEach(function (btn) {
              btn.setAttribute("aria-pressed", String(btn.getAttribute("data-theme-mode") === active));
            });
          }

          syncPressed(currentTheme);

          themeButtons.forEach(function (btn) {
            btn.addEventListener("click", function () {
              var mode = btn.getAttribute("data-theme-mode");
              try { window.localStorage.setItem("verdu-theme", mode); } catch (e) {}
              document.documentElement.setAttribute("data-theme", mode);
              syncPressed(mode);
            });
          });
        })();
      </script>
    </header>

    <main
      id="main"
      tabindex="-1"
      class:list={[
        "w-full",
        shell === "chat" ? "min-h-0 overflow-hidden" : "mx-auto max-w-5xl px-6",
      ]}
    >
      <slot />
    </main>

    <div class="texture" aria-hidden="true"></div>
  </body>
</html>
