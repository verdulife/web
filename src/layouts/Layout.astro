---
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import { SITE } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  shell?: "chat";
}

const {
  title,
  description = SITE.description,
  ogImage,
  shell,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(SITE.url);
const pageTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).href : undefined;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
  </head>

  <body
    class:list={[
      "min-h-screen bg-paper text-ink",
      shell === "chat" && "app-shell",
    ]}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-3 focus:py-2 focus:font-mono focus:text-xs focus:text-paper"
    >
      Saltar al contenido
    </a>

    <header
      class:list={[
        "site-header z-30 border-b border-line bg-paper",
        shell === "chat" ? "relative" : "sticky top-0",
      ]}
    >
      <div class="flex h-full items-center justify-between px-5">
        <a href="/" class="no-underline">
          <span class="font-serif text-3xl font-medium tracking-tight text-ink">V.</span>
        </a>

        <button
          id="menu-button"
          type="button"
          aria-label="Menú"
          class="menu-button cursor-pointer border-0 bg-transparent text-ink transition-colors hover:text-accent"
          aria-expanded="false"
          aria-controls="menu-panel"
        >
          <span class="menu-button-icon" aria-hidden="true"></span>
        </button>
      </div>

      <nav id="menu-panel" aria-label="Navegación" class="site-menu" tabindex="-1" hidden>
        <div class="site-menu-inner">
          <p class="site-menu-kicker">
            <span>Sumario</span>
            <span>Edición local — 2026</span>
          </p>

          <ul class="site-menu-list">
            {
              SITE.nav.map((item, i) => {
                const itemPath = item.href.replace(/\/+$/, "") || "/";
                const isCurrent = itemPath === currentPath;
                const index = String(i + 1).padStart(2, "0");
                return (
                  <li class="site-menu-item">
                    <a
                      href={item.href}
                      aria-current={isCurrent ? "page" : undefined}
                      class="site-menu-link"
                    >
                      <span class="site-menu-index" aria-hidden="true">{index}</span>
                      <span class="site-menu-label">{item.label}</span>
                      <span class="site-menu-arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                );
              })
            }
          </ul>

          <p class="site-menu-colophon">
            <span>Fin del sumario</span>
            <span>Verdu — Sitges</span>
          </p>
        </div>
      </nav>

      <script is:inline>
        (function () {
          var button = document.getElementById("menu-button");
          var panel = document.getElementById("menu-panel");
          if (!button || !panel) return;

          function toggle(open) {
            var willOpen = typeof open === "boolean" ? open : panel.hidden;
            panel.hidden = !willOpen;
            button.setAttribute("aria-expanded", String(willOpen));
            // Lock background scroll while the curtain is open (the chat
            // shell is already scroll-locked; regular pages need it here).
            document.documentElement.style.overflow = willOpen ? "hidden" : "";
            if (willOpen) panel.focus();
          }

          button.addEventListener("click", function (event) {
            event.stopPropagation();
            toggle();
          });

          panel.addEventListener("click", function (event) {
            if (event.target && event.target.closest && event.target.closest("a")) {
              toggle(false);
            }
          });

          document.addEventListener("click", function (event) {
            if (panel.hidden) return;
            if (event.target && event.target.closest && event.target.closest("header")) return;
            toggle(false);
          });

          document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
              toggle(false);
              button.focus();
            }
          });
        })();
      </script>
    </header>

    <main
      id="main"
      tabindex="-1"
      class:list={[
        "w-full",
        shell === "chat" ? "min-h-0 overflow-hidden" : "mx-auto max-w-5xl px-6",
      ]}
    >
      <slot />
    </main>

    <div class="texture" aria-hidden="true"></div>
  </body>
</html>
