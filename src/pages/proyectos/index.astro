---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const projects = (await getCollection("knowledge"))
  .filter((entry) => entry.data.kind === "project")
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "es"));
---

<Layout title="Proyectos">
  <article class="py-14 sm:py-20">
    <p class="kicker">PROYECTOS</p>

    <h1 class="mt-6 font-serif text-4xl font-medium leading-[1.05] tracking-tight sm:text-5xl">
      Proyectos
    </h1>

    <div class="editorial-rule--double mt-8" aria-hidden="true"></div>

    <div class="project-scroller mt-12" role="region" aria-label="Proyectos en scroll horizontal" tabindex="0">
      <ol class="project-track">
        {
          projects.map((entry, index) => (
            <li class="project-card">
              <div class="project-card-top">
                <span class="mono-meta" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                {entry.data.url && (
                  <a class="mono-meta project-card-site" href={entry.data.url} target="_blank" rel="noopener noreferrer">
                    sitio ↗
                  </a>
                )}
              </div>
              <h2 class="project-card-title">
                <a href={`/proyectos/${entry.id.replace("projects/", "")}/`} class="no-underline hover:text-accent">
                  {entry.data.title}
                </a>
              </h2>
              <p class="project-card-desc">{entry.data.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </article>
</Layout>