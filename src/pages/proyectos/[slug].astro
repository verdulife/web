---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("knowledge", ({ data }) => data.kind === "project");

  return projects.map((entry) => ({
    params: { slug: entry.id.replace("projects/", "") },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"knowledge">;
}

const { entry } = Astro.props;

const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <article class="py-14 sm:py-20">
    <p class="kicker">PROYECTO — {entry.data.id}</p>

    <h1 class="mt-6 font-serif text-4xl font-medium leading-[1.05] tracking-tight sm:text-5xl">
      {entry.data.title}
    </h1>

    <p class="mono-meta mt-6 border-b border-line pb-4">
      ID: {entry.data.id} · KIND: project
    </p>

    <div class="prose mt-10">
      <Content />
    </div>

    <p class="mono-meta mt-14 flex items-center gap-2 border-t border-line pt-5">
      <span aria-hidden="true">←</span>
      <a href="/proyectos/" class="no-underline hover:text-accent">
        Todos los proyectos
      </a>
    </p>
  </article>
</Layout>