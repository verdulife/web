---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { SITE } from "../lib/site";

const knowledge = await getCollection("knowledge");

const docById = new Map(knowledge.map((entry) => [entry.data.id, entry]));

const projects = knowledge
  .filter((entry) => entry.data.kind === "project")
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "es"));

const featuredProjects = projects.slice(0, 4);

const about = docById.get("about");
const pageDescription = about?.data.description ?? SITE.description;

// One-line descriptions for the edition index, taken from each document.
const sectionDescriptions: Record<string, string> = {
  "/sobre-mi": docById.get("about")?.data.description ?? "",
  "/habilidades": docById.get("skills")?.data.description ?? "",
  "/servicios": docById.get("services")?.data.description ?? "",
  "/experiencia": docById.get("experience")?.data.description ?? "",
  "/proyectos": `${projects.length} proyectos propios: webs, herramientas y utilidades.`,
  "/contacto": docById.get("contact")?.data.description ?? "",
};

const sections = SITE.nav
  .filter((item) => item.href !== "/")
  .map((item, index) => ({
    label: item.label,
    href: item.href,
    number: String(index + 1).padStart(2, "0"),
    description: sectionDescriptions[item.href] ?? "",
  }));

const conversationSuggestions = [
  { label: "Sobre mí", href: "/sobre-mi" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "Skills", href: "/habilidades" },
  { label: "Servicios", href: "/servicios" },
  { label: "Contacto", href: "/contacto" },
];

// Summaries of the knowledge/services.md sections, kept as plain text.
const services = [
  {
    title: "Diseño y desarrollo web",
    detail: "Webs editoriales y aplicaciones con Astro o SvelteKit.",
  },
  {
    title: "Diseño gráfico y de imprenta",
    detail: "Identidad, piezas impresas y preflight listo para producción.",
  },
  {
    title: "Automatización y herramientas",
    detail: "Integraciones y asistentes propios, como capacidad puntual.",
  },
];

const today = new Intl.DateTimeFormat("es-ES", {
  day: "2-digit",
  month: "long",
  year: "numeric",
}).format(new Date());
const todayIso = new Date().toISOString().slice(0, 10);
---

<Layout
  title="Portfolio — Albert Verdu, diseñador gráfico y desarrollador frontend"
  description={pageDescription}
>
  <article class="pt-14 sm:pt-20">
    {/* 1 — Statement */}
    <header>
      <p class="kicker">EDICIÓN DIGITAL — PORTFOLIO</p>

      <h1 class="mt-6 font-serif text-5xl font-medium leading-[1.02] tracking-tight sm:text-6xl">
        Diseño gráfico
        <span class="block">y desarrollo frontend,</span>
        <span class="block">quince años de oficio</span>
        <span class="block">con mirada editorial.</span>
      </h1>

      <p class="lede dropcap mt-8 max-w-2xl">
        Me llamo Albert Verdu. Trabajo entre Sitges y Barcelona como diseñador gráfico y
        desarrollador frontend. Entiendo el design first como el núcleo de todo: la intención
        visual, la jerarquía y la forma guían la implementación, nunca al revés.
      </p>

      <p
        class="mt-10 flex flex-wrap items-baseline justify-between gap-4 border-t border-line pt-4 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-ink-muted"
      >
        <span>Edición 001 · Sitges · Barcelona</span>
        <time datetime={todayIso}>{today}</time>
      </p>
    </header>

    {/* 2 — Content index */}
    <section class="mt-16 sm:mt-20">
      <h2 class="kicker">EN ESTA EDICIÓN</h2>

      <ol class="mt-8">
        {
          sections.map((section, index) => (
            <li class:list={["py-5", index > 0 && "editorial-rule"]}>
              <div class="grid gap-1 sm:grid-cols-[auto,1fr] sm:gap-6">
                <span class="mono-meta pt-1" aria-hidden="true">
                  {section.number}
                </span>

                <div>
                  <h3 class="font-serif text-2xl font-medium tracking-tight">
                    <a href={section.href} class="no-underline hover:text-accent">
                      {section.label}
                    </a>
                  </h3>

                  <p class="mono-meta mt-2 max-w-2xl normal-case tracking-[0.04em]">
                    {section.description}
                  </p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {/* 3 — Conversation intro zone (placeholder for task 6) */}
    <!-- conversation-ui: task 6 replaces this placeholder block (keep this marker unchanged) -->
    <section id="conversacion" class="mt-16 border-t border-line pt-10 sm:mt-20">
      <p class="kicker">PREGUNTA</p>

      <h2 class="mt-6 max-w-3xl font-serif text-4xl font-medium leading-[1.08] tracking-tight sm:text-5xl">
        Hola. ¿Qué quieres saber de mí?
      </h2>

      <p class="lede mt-6 max-w-2xl">
        Pregúntame por mi trabajo, mis proyectos o mis servicios como si fuera el artículo que
        falta en esta edición.
      </p>

      <ul class="mt-8 flex flex-wrap gap-x-3 gap-y-2">
        {
          conversationSuggestions.map((suggestion) => (
            <li>
              <a
                href={suggestion.href}
                class="mono-meta inline-block border border-line px-3 py-1 no-underline transition-colors hover:border-accent hover:text-accent"
              >
                {suggestion.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {/* 4 — Featured projects */}
    <section class="mt-16 sm:mt-20">
      <h2 class="kicker">PROYECTOS DESTACADOS</h2>

      <ol class="mt-8">
        {
          featuredProjects.map((entry, index) => (
            <li class:list={["py-6", index > 0 && "editorial-rule"]}>
              <h3 class="font-serif text-2xl font-medium tracking-tight">
                <a
                  href={`/proyectos/${entry.id.replace("projects/", "")}/`}
                  class="no-underline hover:text-accent"
                >
                  {entry.data.title}
                </a>
              </h3>

              <p class="mono-meta mt-2">ID: {entry.data.id}</p>

              <p class="mt-2 max-w-2xl text-ink-muted">{entry.data.description}</p>
            </li>
          ))
        }
      </ol>

      <p class="mono-meta mt-6">
        <a href="/proyectos" class="no-underline hover:text-accent">Todos los proyectos →</a>
      </p>
    </section>

    {/* 5 — Services teaser */}
    <section class="mt-16 sm:mt-20">
      <h2 class="kicker">SERVICIOS</h2>

      <ul class="mt-8 max-w-2xl space-y-3">
        {
          services.map((service) => (
            <li>
              <span class="font-serif text-lg text-ink">{service.title}</span>
              <span class="text-ink-muted"> — {service.detail}</span>
            </li>
          ))
        }
      </ul>

      <p class="mono-meta mt-6">
        <a href="/servicios" class="no-underline hover:text-accent">Servicios completos →</a>
      </p>
    </section>

    {/* 6 — Contact strip */}
    <section class="mt-16 pb-8 sm:mt-20" aria-label="Contacto">
      <div class="editorial-rule--double" aria-hidden="true"></div>

      <p class="mono-meta mt-6 flex flex-wrap items-center gap-x-3 gap-y-2">
        <span>Sitges, Barcelona</span>
        <span aria-hidden="true">·</span>
        <a
          href="https://www.linkedin.com/in/albert-verdu/"
          rel="me noopener"
          target="_blank"
          class="no-underline hover:text-accent">LinkedIn</a
        >
        <span aria-hidden="true">·</span>
        <a
          href="https://github.com/verdulife"
          rel="me noopener"
          target="_blank"
          class="no-underline hover:text-accent">GitHub</a
        >
      </p>
    </section>
  </article>
</Layout>
